# =============================================================================
# Project Aura 2.0 - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control. It is listed in .gitignore.
# =============================================================================

# --- General Application Settings ---
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=project-aura
PROJECT_VERSION=2.0.0

# --- Google Colab Settings ---
# Set to "true" when running in Google Colab with GPU/TPU
COLAB_RUNTIME=local
ENABLE_GPU=false
ENABLE_TPU=false
MOUNT_GDRIVE=false

# --- Computer Vision Settings ---
VISION_MODEL_NAME=efficientnet_b0
VISION_NUM_CLASSES=10
VISION_INPUT_SIZE=224
VISION_BATCH_SIZE=32
VISION_LEARNING_RATE=1e-4
VISION_EPOCHS=10
VISION_PRETRAINED=true

# --- Gesture Recognition Settings ---
GESTURE_CONFIDENCE_THRESHOLD=0.7
GESTURE_MAX_NUM_HANDS=2
GESTURE_MIN_DETECTION_CONFIDENCE=0.5
GESTURE_MIN_TRACKING_CONFIDENCE=0.5

# --- AI Agent Settings ---
AGENT_NAME=aura-agent
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
AGENT_ENABLE_TOOLS=true

# --- Cloud Infrastructure Settings ---
# Choose: gcp, aws, or azure
CLOUD_PROVIDER=gcp
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4